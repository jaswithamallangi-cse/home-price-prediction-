
# Task 2: XGBoost Home Price Prediction

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from xgboost import XGBRegressor

# --------------------------------------------------
# 1. Load the dataset
# --------------------------------------------------

# Replace this with the path to your downloaded CSV file
df = pd.read_csv("home_prices.csv")

# Display the first five rows
print("First five rows:")
print(df.head())

print("\nDataset information:")
print(df.info())

print("\nMissing values:")
print(df.isnull().sum())

# --------------------------------------------------
# 2. Clean the dataset
# --------------------------------------------------

# Remove duplicate rows
df = df.drop_duplicates()

# Fill missing numerical values with their column median
numeric_cols = df.select_dtypes(include=np.number).columns
df[numeric_cols] = df[numeric_cols].fillna(
    df[numeric_cols].median()
)

# Fill missing categorical values with the most frequent value
categorical_cols = df.select_dtypes(
    include=["object", "category"]
).columns

for col in categorical_cols:
    if df[col].isnull().any():
        df[col] = df[col].fillna(df[col].mode()[0])

# --------------------------------------------------
# 3. Select features and target
# --------------------------------------------------

# Change "Price" to the actual target column in your dataset
target_column = "Price"

if target_column not in df.columns:
    raise ValueError(
        f"Target column '{target_column}' not found. "
        f"Available columns: {list(df.columns)}"
    )

X = df.drop(columns=[target_column])
y = df[target_column]

# Convert categorical features into numerical columns
X = pd.get_dummies(X, drop_first=True, dtype=int)

# --------------------------------------------------
# 4. Split the dataset
# --------------------------------------------------

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)

print("\nTraining samples:", len(X_train))
print("Testing samples:", len(X_test))

# --------------------------------------------------
# 5. Train the XGBoost model
# --------------------------------------------------

model = XGBRegressor(
    n_estimators=500,
    learning_rate=0.05,
    max_depth=5,
    subsample=0.8,
    colsample_bytree=0.8,
    objective="reg:squarederror",
    random_state=42,
    n_jobs=-1,
    early_stopping_rounds=30
)

model.fit(
    X_train,
    y_train,
    eval_set=[(X_test, y_test)],
    verbose=False
)

print("\nModel training completed!")

# --------------------------------------------------
# 6. Make predictions
# --------------------------------------------------

y_pred = model.predict(X_test)

# --------------------------------------------------
# 7. Evaluate the model
# --------------------------------------------------

mae = mean_absolute_error(y_test, y_pred)
mse = mean_squared_error(y_test, y_pred)
rmse = np.sqrt(mse)
r2 = r2_score(y_test, y_pred)

print("\nModel Evaluation Results")
print("------------------------")
print(f"MAE  : {mae:.2f}")
print(f"MSE  : {mse:.2f}")
print(f"RMSE : {rmse:.2f}")
print(f"R²   : {r2:.4f}")

# --------------------------------------------------
# 8. Compare actual and predicted prices
# --------------------------------------------------

results = pd.DataFrame({
    "Actual Price": y_test.values,
    "Predicted Price": y_pred
})

results["Difference"] = (
    results["Actual Price"] - results["Predicted Price"]
)

print("\nActual vs Predicted Prices:")
print(results.head(10))

results.to_csv("prediction_results.csv", index=False)

# --------------------------------------------------
# 9. Visualize actual vs predicted prices
# --------------------------------------------------

plt.figure(figsize=(8, 6))

sns.scatterplot(
    x=y_test,
    y=y_pred,
    alpha=0.7
)

min_price = min(y_test.min(), y_pred.min())
max_price = max(y_test.max(), y_pred.max())

plt.plot(
    [min_price, max_price],
    [min_price, max_price],
    "r--",
    label="Perfect Prediction"
)

plt.xlabel("Actual House Prices")
plt.ylabel("Predicted House Prices")
plt.title("XGBoost: Actual vs Predicted Prices")
plt.legend()
plt.tight_layout()
plt.show()

# --------------------------------------------------
# 10. Feature importance
# --------------------------------------------------

importance = pd.Series(
    model.feature_importances_,
    index=X.columns
).sort_values(ascending=False)

print("\nTop 10 Important Features:")
print(importance.head(10))

plt.figure(figsize=(10, 6))

importance.head(10).sort_values().plot(
    kind="barh"
)

plt.title("Top 10 Features Affecting House Prices")
plt.xlabel("Feature Importance")
plt.tight_layout()
plt.show()

# --------------------------------------------------
# 11. Predict the price of a new house
# --------------------------------------------------

# Example values below are placeholders.
# Replace them with values matching your dataset.

new_house = pd.DataFrame(
    0,
    index=[0],
    columns=X.columns
)

# Set values for matching numerical features
example_values = {
    "Income": 75000,
    "Schools": 8,
    "Hospitals": 3,
    "CrimeRate": 2.5
}

for feature, value in example_values.items():
    if feature in new_house.columns:
        new_house.loc[0, feature] = value

predicted_price = model.predict(new_house)[0]

print("\nPredicted Price for New House:")
print(f"{predicted_price:,.2f}")

print("\nProject completed successfully!")
